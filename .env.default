# ---- Images / versions --------------------------------------
# Gitea MUST be >= 1.23 for the auto-registration token to work.
GITEA_IMAGE=gitea/gitea:1.27-rootless
RUNNER_IMAGE=gitea/runner:1.0-dind
POSTGRES_IMAGE=postgres:18-alpine

# ---- Host ports ---------------------------------------------
HTTP_PORT=3000
SSH_PORT=2222

# ---- Public URL (injected into instance.ini [server]) -------
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3000/

# ---- Admin account (created automatically on first start) ---
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=admin_password
GITEA_ADMIN_EMAIL=admin@example.com
GITEA_DISABLE_REGISTER=false

# ---- Database (single source for DB creds) ------------------
# Used by the Postgres container AND injected into instance.ini
# ([database]). Change them here and nowhere else.
POSTGRES_DB=gitea
POSTGRES_USER=gitea
POSTGRES_PASSWORD=db_password

# ---- Action runners -----------------------------------------
# How many runner containers to start. They all auto-register.
RUNNER_REPLICAS=1

# Reusable global registration token shared by Gitea + runners.
# MUST be exactly 40 characters.
# use the following command to generate a random value:
# python -c 'import hashlib,os;print(hashlib.sha256(os.urandom(16)).hexdigest()[:40])'
RUNNER_REGISTRATION_TOKEN=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Labels decide which container image each job runs in
# (GitHub-Actions-style: "<label>:docker://<image>").
RUNNER_LABELS=ubuntu-latest:docker://docker.gitea.com/runner-images:ubuntu-latest,ubuntu-22.04:docker://docker.gitea.com/runner-images:ubuntu-22.04

# ---- Misc ---------------------------------------------------
APP_NAME="Gitea is running !"
TZ=Europe/Paris
