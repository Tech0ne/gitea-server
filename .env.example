# =====================================================================
#  Gitea stack configuration — the ONLY file you need to edit.
#  cp .env.example .env && $EDITOR .env && just install
#  Empty secrets are auto-generated by `just check` (and written back here).
# =====================================================================

# ---------- Install ----------
# Where `just install` copies the stack (compose, scripts, this .env)
INSTALL_DIR=/opt/gitea
# Where persistent data lives (gitea repos, postgres, runner). Bind mounts.
DATA_DIR=/opt/gitea/data
# systemd unit name
SERVICE_NAME=gitea

# ---------- Versions (pin them, upgrade on purpose) ----------
GITEA_VERSION=1.26
POSTGRES_VERSION=17
RUNNER_VERSION=latest

# ---------- Instance ----------
APP_NAME=My Gitea
# Hostname/IP people use to reach the instance
DOMAIN=gitea.local
HTTP_PORT=3000
SSH_PORT=2222
# Full public URL (change to https://... if behind a reverse proxy)
ROOT_URL=http://gitea.local:3000/
# true = only admins can create accounts
DISABLE_REGISTRATION=true
# true = must be logged in to see anything
REQUIRE_SIGNIN_VIEW=false
# Timezone for logs/cron display
TZ=Europe/Paris
# UID/GID owning gitea files on the host
USER_UID=1000
USER_GID=1000

# ---------- Admin account (created on first start if missing) ----------
# Note: "admin" is a reserved name in Gitea, pick something else.
ADMIN_USER=root
ADMIN_EMAIL=root@example.com
# min 8 chars, empty = generated. Only used to CREATE the account: change it later in the web UI, not here.
ADMIN_PASSWORD=

# ---------- Database ----------
POSTGRES_DB=gitea
POSTGRES_USER=gitea
# Only applied when the DB is first created — don't change it afterwards.
POSTGRES_PASSWORD=

# ---------- Actions runner ----------
# true/false — enables Gitea Actions + the bundled runner
RUNNER_ENABLED=true
RUNNER_NAME=pi-runner
# Parallel jobs
RUNNER_CAPACITY=1
# comma separated  label:docker://image
RUNNER_LABELS=ubuntu-latest:docker://node:20-bookworm,ubuntu-24.04:docker://node:20-bookworm

# ---------- Backup (`just install-backup`) ----------
BACKUP_DIR=/mnt/backup/gitea-backups
# If set, scheduled backups abort unless this is a mounted filesystem (USB stick not plugged = no backup filling the SD card)
BACKUP_MOUNTPOINT=/mnt/backup
# cron syntax — default: Sunday 03:00
BACKUP_SCHEDULE=0 3 * * 0
# Scheduled backups kept
BACKUP_KEEP=8
# Optional healthchecks.io-style ping URL (alerts on failure / missed run)
BACKUP_HC_URL=

# ---------- Secrets (leave empty: auto-generated) ----------
# KEEP THESE: restoring a backup needs the same SECRET_KEY (2FA, encrypted fields). They are in every backup.
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=
RUNNER_REGISTRATION_TOKEN=

# ---------- Managed by just (don't edit) ----------
COMPOSE_PROFILES=
